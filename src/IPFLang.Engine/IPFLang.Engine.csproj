<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>IPFLang</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>IPFLang.Engine</PackageId>
    <Version>1.3.0</Version>
    <Authors>Valer Bocan</Authors>
    <Company>Politehnica University of Timisoara</Company>
    <Title>IPFLang Engine</Title>
    <Description>Parser, currency-aware type system, static verification, provenance and composition engine for IPFLang, a domain-specific language for multi-currency regulatory fee computation.</Description>
    <PackageTags>dsl;domain-specific-language;intellectual-property;patent-fees;fee-calculation;legal-tech;type-system;static-verification;currency;iso-4217</PackageTags>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/vbocan/IPFLang</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vbocan/IPFLang</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) 2025-2026 Valer Bocan</Copyright>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\packages</PackageOutputPath>
    <!-- The engine ships XML docs; do not fail the build on undocumented public members. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    The production jurisdiction corpus travels with the engine. A consumer that references
    the package gets the fee schedules along with the language, so it can seed a database or
    check itself against the reference corpus without depending on a checkout of this repo.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\jurisdictions\**\*.ipf">
      <Link>Corpus\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>

</Project>
